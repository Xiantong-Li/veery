{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "veery",
  "version": "0.1.0",
  "identifier": "dev.veery.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "veery",
        "width": 960,
        "height": 132,
        "backgroundColor": "#00000000",
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "noRedirectionBitmap": true,
        "dragDropEnabled": false,
        "dataDirectory": "webview",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,BackForwardCache,AudioServiceOutOfProcess,TranslateUI,CalculateNativeWinOcclusion --disable-background-networking --disable-component-update --disable-domain-reliability --disable-sync --disable-extensions --disable-default-apps --disable-breakpad --metrics-recording-only --no-first-run --renderer-process-limit=1 --disk-cache-size=1 --media-cache-size=1 --disable-gpu-shader-disk-cache",
        "center": true,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "resizable": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
